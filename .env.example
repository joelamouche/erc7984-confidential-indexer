# ──────────────────────────────────────────────────────────────────────────
# Confidential Indexer — environment
# Copy to `.env` and fill in. TOY VALUES / TEST MNEMONIC ONLY. Never commit .env
# or a mnemonic that controls real funds. Every variable the service reads is here.
# ──────────────────────────────────────────────────────────────────────────

# --- Accounts: one HD mnemonic, role-indexed -----------------------------
# ALL actors (funder, deployer, indexer holder, test users) derive from this one
# mnemonic via BIP-44. This is the well-known PUBLIC hardhat/anvil test mnemonic —
# replace it, but only ever with a throwaway test seed holding no real funds.
MNEMONIC="test test test test test test test test test test test junk"
# BIP-44 path prefix; accounts are at <prefix>/<index>, e.g. m/44'/60'/0'/0/0
DERIVATION_PATH="m/44'/60'/0'/0"

# Role -> derivation index (all derived from MNEMONIC above):
#   funder        : you fund THIS one from a Sepolia faucet; it fans gas to the rest
#   deployer      : deploys the toy ERC-7984 token + wrapper
#   indexer holder: the indexer's decryption identity (the delegate); submits no txs
FUNDER_INDEX="0"
DEPLOYER_INDEX="1"
INDEXER_HOLDER_INDEX="2"
# Test users that generate realistic activity (transfers, wrap/unwrap, delegations).
# Derived at indices [TEST_USER_START_INDEX .. START+COUNT-1].
TEST_USER_START_INDEX="3"
TEST_USER_COUNT="4"

# --- Funding (scripts/fund.ts: funder -> everyone else) ------------------
# Per-role gas TARGET balances, in ETH (fund.ts tops each role up to its target,
# so it's idempotent). Sized for cheap Sepolia gas: deployer most (FHE deploys are
# heavy), the indexer holder ~none (off-chain signing only), users a little each.
# Defaults total ~0.06 ETH for 4 users — fund the funder with at least that.
FUND_DEPLOYER_ETH="0.025"
FUND_INDEXER_HOLDER_ETH="0.002"
FUND_TEST_USER_ETH="0.008"

# --- Chain / RPC ---------------------------------------------------------
# Indexing RPC (Ponder: heavy eth_getLogs). Use a solid endpoint. Free Infura/
# Alchemy keys work, but free Infura throttles hard on a large historical catch-up
# (~1 req/s) — https://sepolia.drpc.org indexes much faster (~23 req/s) with no key.
SEPOLIA_RPC_URL="https://sepolia.drpc.org"
# Decryption RPC (the SDK: bursty batched eth_calls). Kept separate so it doesn't
# fight the indexer on one throttled endpoint. A public node is fine here; defaults
# to SEPOLIA_RPC_URL if unset. (A free Infura key 429s the SDK's bursts — use a
# public node or Alchemy for this one.)
DECRYPT_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
CHAIN_ID="11155111"
# Etherscan API key — used by the Foundry deploy script to verify the toy token +
# wrapper on Sepolia Etherscan (forge ... --verify). Optional; deploy works
# without it, you just skip source verification.
ETHERSCAN_API_KEY=""

# --- Contracts -----------------------------------------------------------
# Pre-filled with OUR live Sepolia deployment so a fresh clone can `npm run dev`
# and index real data immediately (these are public addresses, not secrets).
# `npm run deploy` overwrites them if you deploy your own. The token IS the wrapper
# (ConfidentialUSD), so TOKEN and WRAPPER are the same address. UNDERLYING is the
# cleartext ERC20 (ToyUSD) used by seed scripts, not indexed.
# NOTE: cleartext amounts for the live data were decrypted by our holder identity;
# with the default mnemonic below you'll see the events + honest `pending_rights`
# states (run the demo with your own funded mnemonic, or watch the video, for
# cleartext).
TOKEN_ADDRESS="0x262659F9DcF62fd3924B0A9B3ff5Be6DCd913aAb"
WRAPPER_ADDRESS="0x262659F9DcF62fd3924B0A9B3ff5Be6DCd913aAb"
UNDERLYING_USD_ADDRESS="0xbF4D3Ca143ddE2A33Ca84fFAEec3C3b16E7338f5"
# Block to start indexing from (the token's deploy block keeps backfill cheap).
START_BLOCK="11095410"
# Canonical fhEVM ACL contract on Sepolia — indexed for delegation events.
# Defaults to the constant below; override only if Zama redeploys it.
ACL_ADDRESS="0xf0Ffdc93b7E186bC2f8CB3dAA75D86d1930A433D"

# --- Zama SDK / relayer --------------------------------------------------
# Optional relayer API key header, if your relayer endpoint requires one.
RELAYER_API_KEY=""

# --- Backfill worker -----------------------------------------------------
# How often (ms) to re-attempt pending_rights / pending_propagation / failed rows.
BACKFILL_INTERVAL_MS="30000"
# Max decrypt attempts before a row is parked as `failed`.
DECRYPT_MAX_ATTEMPTS="6"

# --- API -----------------------------------------------------------------
# Port for the read API (Ponder default is 42069).
PORT="42069"
# Indexing freshness threshold (seconds). /v1/health reports indexing as
# `degraded` when secondsBehind exceeds this.
MAX_LAG_SECONDS="120"
# Decryption-lag threshold (seconds) for /v1/health `degraded`. Generous on
# purpose (history backfill drains in ~seconds but can show old block ages).
MAX_DECRYPT_LAG_SECONDS="600"
