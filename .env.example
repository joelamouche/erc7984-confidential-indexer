# ──────────────────────────────────────────────────────────────────────────
# Confidential Indexer — environment
# Copy to `.env` and fill in. TOY VALUES / EOA TEST KEYS ONLY. Never commit .env.
# Every variable the service reads is listed here.
# ──────────────────────────────────────────────────────────────────────────

# --- Chain / RPC ---------------------------------------------------------
# Sepolia RPC endpoint (Alchemy/Infura/public). Used by Ponder and the SDK.
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-key"
# Chain id. Sepolia = 11155111. Leave as-is unless you change networks.
CHAIN_ID="11155111"

# --- Contracts -----------------------------------------------------------
# The single ERC-7984 confidential token the indexer watches.
TOKEN_ADDRESS="0x..."
# The ERC-20 <-> confidential wrapper (shield/unshield). Optional; enables
# wrap/unwrap event handling and the shield/unshield activity feed.
WRAPPER_ADDRESS="0x..."
# Block to start indexing from (the token's deploy block keeps backfill cheap).
START_BLOCK="0"

# --- Indexer holder identity (the decryption identity) -------------------
# Private key of the EOA the indexer decrypts as. It can decrypt amounts it is a
# party to, plus any handles delegated to it via ACL. TEST KEY ONLY.
INDEXER_HOLDER_PRIVATE_KEY="0x..."

# --- Zama SDK / relayer --------------------------------------------------
# Optional relayer API key header, if your relayer endpoint requires one.
RELAYER_API_KEY=""

# --- Backfill worker -----------------------------------------------------
# How often (ms) to re-attempt pending_rights / pending_propagation / failed rows.
BACKFILL_INTERVAL_MS="30000"
# Max decrypt attempts before a row is parked as `failed`.
DECRYPT_MAX_ATTEMPTS="6"

# --- API -----------------------------------------------------------------
# Port for the read API (Ponder default is 42069).
PORT="42069"
# Freshness threshold (seconds). The /health endpoint and a guarded read path
# report the indexer as degraded/unhealthy when it is more than this far behind.
MAX_LAG_SECONDS="120"

# --- Contract deploy script (Foundry) — only needed to deploy the toy token --
# Deployer EOA private key. TEST KEY ONLY.
DEPLOYER_PRIVATE_KEY="0x..."
