# ──────────────────────────────────────────────────────────────────────────
# Confidential Indexer — environment
# Copy to `.env` and fill in. TOY VALUES / TEST MNEMONIC ONLY. Never commit .env
# or a mnemonic that controls real funds. Every variable the service reads is here.
# ──────────────────────────────────────────────────────────────────────────

# --- Accounts: one HD mnemonic, role-indexed -----------------------------
# ALL actors (funder, deployer, indexer holder, test users) derive from this one
# mnemonic via BIP-44. This is the well-known PUBLIC hardhat/anvil test mnemonic —
# replace it, but only ever with a throwaway test seed holding no real funds.
MNEMONIC="test test test test test test test test test test test junk"
# BIP-44 path prefix; accounts are at <prefix>/<index>, e.g. m/44'/60'/0'/0/0
DERIVATION_PATH="m/44'/60'/0'/0"

# Role -> derivation index (all derived from MNEMONIC above):
#   funder        : you fund THIS one from a Sepolia faucet; it fans gas to the rest
#   deployer      : deploys the toy ERC-7984 token + wrapper
#   indexer holder: the indexer's decryption identity (the delegate); submits no txs
FUNDER_INDEX="0"
DEPLOYER_INDEX="1"
INDEXER_HOLDER_INDEX="2"
# Test users that generate realistic activity (transfers, wrap/unwrap, delegations).
# Derived at indices [TEST_USER_START_INDEX .. START+COUNT-1].
TEST_USER_START_INDEX="3"
TEST_USER_COUNT="4"

# --- Funding (scripts/fund.ts: funder -> everyone else) ------------------
# Per-role gas top-ups, in ETH. Deployer needs the most (FHE deploys are heavy);
# the indexer holder barely needs any (off-chain signing only).
FUND_DEPLOYER_ETH="0.1"
FUND_INDEXER_HOLDER_ETH="0.005"
FUND_TEST_USER_ETH="0.02"

# --- Chain / RPC ---------------------------------------------------------
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-key"
CHAIN_ID="11155111"

# --- Contracts -----------------------------------------------------------
# Filled in after deploy (scripts/deploy). The single ERC-7984 token the indexer
# watches, and its ERC-20 <-> confidential wrapper (shield/unshield).
TOKEN_ADDRESS="0x..."
WRAPPER_ADDRESS="0x..."
# Block to start indexing from (the token's deploy block keeps backfill cheap).
START_BLOCK="0"
# Canonical fhEVM ACL contract on Sepolia — indexed for delegation events.
# Defaults to the constant below; override only if Zama redeploys it.
ACL_ADDRESS="0xf0Ffdc93b7E186bC2f8CB3dAA75D86d1930A433D"

# --- Zama SDK / relayer --------------------------------------------------
# Optional relayer API key header, if your relayer endpoint requires one.
RELAYER_API_KEY=""

# --- Backfill worker -----------------------------------------------------
# How often (ms) to re-attempt pending_rights / pending_propagation / failed rows.
BACKFILL_INTERVAL_MS="30000"
# Max decrypt attempts before a row is parked as `failed`.
DECRYPT_MAX_ATTEMPTS="6"

# --- API -----------------------------------------------------------------
# Port for the read API (Ponder default is 42069).
PORT="42069"
# Freshness threshold (seconds). /health and a guarded read path report the
# indexer as degraded/unhealthy when it is more than this far behind.
MAX_LAG_SECONDS="120"
